# ─────────────────────────────────────────────────────────────
# LegalMCP — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Internal Docker Compose URL (services talk to each other on port 5432)
DATABASE_URL=postgres://legal:legal_dev_password@postgres:5432/legalmcp

# For local development connecting from the host (postgres exposed on 5433)
# DATABASE_URL=postgres://legal:legal_dev_password@localhost:5433/legalmcp

POSTGRES_USER=legal
POSTGRES_PASSWORD=legal_dev_password_change_in_prod
POSTGRES_DB=legalmcp

# ── Rust API Service ──────────────────────────────────────────
API_PORT=8000
RUST_LOG=info,api=debug

# ── Vertex AI (required for production embeddings) ────────────
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=europe-west3

# Path to GCP service account JSON key file
# For Cloud Run, omit this and use Workload Identity instead.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Object Storage ────────────────────────────────────────────
# "memory" for local dev, "gcs" or "azure" for production
OBJECT_STORE_TYPE=memory

# Google Cloud Storage (when OBJECT_STORE_TYPE=gcs)
GCS_BUCKET=your-legalmcp-documents-bucket

# Azure Blob Storage (when OBJECT_STORE_TYPE=azure)
AZURE_STORAGE_ACCOUNT=yourazureaccount
AZURE_STORAGE_KEY=your-azure-storage-key
AZURE_CONTAINER=legalmcp-documents

# ── Mistral (required for PDF extraction in crawler-service) ──
MISTRAL_API_KEY=your-mistral-api-key

# ── Frontend ──────────────────────────────────────────────────
# In Docker Compose, the frontend container reaches the API via the
# internal service name. For host-browser access, use localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MCP_URL=http://localhost:8000/mcp
