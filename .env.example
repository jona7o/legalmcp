# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=legalmcp
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal_dev_password_change_in_prod

# MCP Server
MCP_SERVER_PORT=8000
API_KEY_HEADER=X-API-Key
EMBEDDING_MODEL=deepset/gbert-base
EMBEDDING_BATCH_SIZE=32

# Crawler
CRAWLER_RATE_LIMIT=1.0
CRAWLER_USER_AGENT=LegalMCP-Bot/1.0 (+https://github.com/yourorg/legalmcp)

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MCP_URL=http://localhost:8000/mcp

# Vertex AI (optional - für Gemini Chat)
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=europe-west3
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Firebase (optional - für Hosting)
FIREBASE_PROJECT_ID=your-firebase-project

# Development
NODE_ENV=development
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
