# Environment variables for Legal MCP Crawler

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legalmcp
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal_dev_password

# Crawler Settings
CRAWLER_RATE_LIMIT=1.0
CRAWLER_MAX_CONCURRENT=5
CRAWLER_TIMEOUT=30
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_USER_AGENT=LegalMCP-Crawler/1.0 (https://github.com/your-org/legalmcp)

# Embedding Model
EMBEDDING_MODEL=deepset/gbert-base
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=512

# Chunking Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Logging
LOG_LEVEL=INFO

# Cache Directory
CACHE_DIR=./cache

# Enable/Disable Data Sources
ENABLE_BUNDESRECHT=true
ENABLE_BAYERN=true
ENABLE_EURLEX=true

# Data Source URLs
BUNDESRECHT_XML_URL=https://www.gesetze-im-internet.de/gii-toc.xml
BAYERN_BASE_URL=https://www.gesetze-bayern.de
EURLEX_SPARQL_ENDPOINT=https://publications.europa.eu/webapi/rdf/sparql
EURLEX_CELLAR_ENDPOINT=https://eur-lex.europa.eu/legal-content
